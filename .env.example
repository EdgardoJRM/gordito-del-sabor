# Environment variables for development
# Copy this file to .env.local and update with your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=El Gordito del Sabor

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Stripe — Payment Links (cobro directo en Stripe, sin API checkout)
# Cupón 35SPECIAL en el link Personalizado = delantal sin bordado a $35
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=https://buy.stripe.com/your-premium-link
NEXT_PUBLIC_STRIPE_LINK_VIP=https://buy.stripe.com/your-vip-link
NEXT_PUBLIC_STRIPE_LINK_LEGADO=https://buy.stripe.com/your-legado-link

# Stripe API (webhooks + confirmación de pedidos)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
# LIVE: sk_live_... desde Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_your_key_here
# Local: stripe listen --live --forward-to localhost:3001/api/webhooks/stripe
# Producción: whsec_ del endpoint en Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Delantal countdown — solo activo si DELANTAL_COUNTDOWN_ENABLED=true
DELANTAL_COUNTDOWN_ENABLED=false
DELANTAL_COUNTDOWN_END=2026-06-15T18:37:00.000Z
NEXT_PUBLIC_DELANTAL_COUNTDOWN_END=2026-06-15T18:37:00.000Z
# Recetario público en /recetario (false = solo con compra del delantal)
RECETARIO_GRATIS_ENABLED=false
# Preview secreto — solo tú: gorditodelsabor.com/delantal-el-gordito?preview=TU_SECRETO
DELANTAL_PREVIEW_SECRET=cambia-esto-por-un-secreto-largo

# NEXT_PUBLIC_GA_ID=

# Email Configuration (optional)
# NEXT_PUBLIC_CONTACT_EMAIL=info@gorditodelsabor.com
RESEND_API_KEY=re_your_resend_key_here
# Remitente — dominio verificado en Resend (https://resend.com/domains)
RESEND_FROM=El Gordito del Sabor <noreply@gorditodelsabor.com>
# Aviso de cada pedido delantal (default: elgorditodelsaborshop@gmail.com)
PAPA_ORDER_NOTIFY_EMAIL=elgorditodelsaborshop@gmail.com
