# Environment variables for development
# Copy this file to .env.local and update with your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=El Gordito del Sabor

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Stripe — Payment Links (cobro directo en Stripe, sin API checkout)
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=https://buy.stripe.com/your-premium-link
NEXT_PUBLIC_STRIPE_LINK_VIP=https://buy.stripe.com/your-vip-link
NEXT_PUBLIC_STRIPE_LINK_LEGADO=https://buy.stripe.com/your-legado-link

# Stripe API (opcional: webhooks / admin; no requerido para Payment Links)
que email de confirmacion leNEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Delantal countdown — bloquea el sitio hasta esta hora (ISO UTC)
DELANTAL_COUNTDOWN_ENABLED=true
DELANTAL_COUNTDOWN_END=2026-06-15T18:07:00.000Z
NEXT_PUBLIC_DELANTAL_COUNTDOWN_END=2026-06-15T18:07:00.000Z
# Preview secreto — solo tú: gorditodelsabor.com/el-sabor-de-papa?preview=TU_SECRETO
DELANTAL_PREVIEW_SECRET=cambia-esto-por-un-secreto-largo

# NEXT_PUBLIC_GA_ID=

# Email Configuration (optional)
# NEXT_PUBLIC_CONTACT_EMAIL=info@gorditodelsabor.com
RESEND_API_KEY=re_your_resend_key_here
# Aviso de cada pedido delantal (default: elgorditodelsabor@gmail.com)
PAPA_ORDER_NOTIFY_EMAIL=elgorditodelsaborshop@gmail.com
